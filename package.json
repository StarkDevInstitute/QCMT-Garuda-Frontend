{
  "name": "scmtv-bmkg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:public": "vite preview --host 0.0.0.0 --port 5174",
    "pm2:start:dev": "npx pm2 start ecosystem.config.cjs --only scmtv-dev",
    "pm2:start:prod": "npx pm2 start ecosystem.config.cjs --only scmtv-prod",
    "pm2:restart:dev": "npx pm2 restart scmtv-dev",
    "pm2:restart:prod": "npx pm2 restart scmtv-prod",
    "pm2:stop:dev": "npx pm2 stop scmtv-dev",
    "pm2:stop:prod": "npx pm2 stop scmtv-prod",
    "pm2:delete:dev": "npx pm2 delete scmtv-dev",
    "pm2:delete:prod": "npx pm2 delete scmtv-prod",
    "pm2:logs:dev": "npx pm2 logs scmtv-dev --lines 100",
    "pm2:logs:prod": "npx pm2 logs scmtv-prod --lines 100",
    "pm2:save": "npx pm2 save",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "react-window": "^2.2.7",
    "tailwind-merge": "^2.5.2",
    "three": "^0.168.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^2.0.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "pm2": "^6.0.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1"
  }
}
